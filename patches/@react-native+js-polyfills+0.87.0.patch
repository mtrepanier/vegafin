diff --git a/node_modules/@react-native/js-polyfills/console.js b/node_modules/@react-native/js-polyfills/console.js
index 4968c3e..6414640 100644
--- a/node_modules/@react-native/js-polyfills/console.js
+++ b/node_modules/@react-native/js-polyfills/console.js
@@ -389,6 +389,24 @@ const LOG_LEVELS = {
   error: 3,
 };
 
+// PATCHED (see patches/@react-native+js-polyfills+*.patch, applied via patch-package):
+// `global.nativeLoggingHook` is a synchronous call into native logging, on the same JS thread
+// as everything else - rendering, event handling, media playback state. Confirmed as a real
+// cause of "playback randomly stops" on real Fire TV hardware (not reproduced on the Virtual
+// Device): AmbientFlare/astra-tv, a separate Jellyfin-for-Vega client, documented the identical
+// symptom (resuming, switching audio tracks, and turning on subtitles could each exit to Home)
+// and root-caused it to exactly this - native logging blocking the JS thread during media
+// operations on Vega OS 1.2, which this app's own vendored Shaka Player/w3cmedia logging is
+// more than capable of triggering (it logs on essentially every state transition and segment
+// append). In `__DEV__` this still calls straight through, unchanged, so on-device debugging
+// via `vega device start-log-stream` keeps working exactly as it always has; only release
+// builds - what real users actually run - buffer log/info/warn in memory instead of paying for
+// a native call every time. `console.error` always still goes straight through in both modes:
+// it's the rare, high-value case worth its own synchronous cost.
+const RELEASE_LOG_BUFFER_LIMIT = 200;
+const releaseLogBuffer = [];
+global.__vegafinReleaseLogBuffer = releaseLogBuffer;
+
 function getNativeLogFunction(level) {
   return function () {
     let str;
@@ -424,7 +442,15 @@ function getNativeLogFunction(level) {
     if (groupStack.length) {
       str = groupFormat('', str);
     }
-    global.nativeLoggingHook(str, logLevel);
+
+    if (__DEV__ || logLevel === LOG_LEVELS.error) {
+      global.nativeLoggingHook(str, logLevel);
+      return;
+    }
+    releaseLogBuffer.push(str);
+    if (releaseLogBuffer.length > RELEASE_LOG_BUFFER_LIMIT) {
+      releaseLogBuffer.shift();
+    }
   };
 }
 
